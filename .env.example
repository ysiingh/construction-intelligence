# Copy to .env (local) or set these as environment variables on Render. NEVER commit .env or real keys.

# --- AI provider: any OpenAI-compatible chat-completions API (Groq shown) ---
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
# Text model: planning, valuation, chat, daily plan, weather guidance
OPENAI_MODEL=openai/gpt-oss-20b
# Vision-capable model: REQUIRED for Site Safety and Crack Analysis. A text-only model cannot read images.
# Model names change; check the provider's vision docs (https://console.groq.com/docs/vision) and GET /api/ai/check.
OPENAI_VISION_MODEL=qwen/qwen3.6-27b

AI_TIMEOUT_SECONDS=60

# --- Browser access (comma separated, no spaces needed, trailing slashes are ignored) ---
CORS_ORIGINS=http://localhost:5173,https://your-site.netlify.app

# --- Optional ---
# DB_PATH=./data.db
# LOG_LEVEL=INFO
# HOST=127.0.0.1   # only used by "python app.py"; on Render the start command sets 0.0.0.0
# PORT=8000        # only used by "python app.py"; Render provides $PORT itself
